{
  "name": "cleverreach/php-sdk",
  "type": "library",
  "description": "PHP SDK for the CleverReach REST API",
  "keywords": [
    "cleverreach",
    "newsletter",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://github.com/cleverreach/cleverreachsdk-php",
  "license": "MIT",
  "authors": [
    {
      "name": "CleverReach GmbH & Co. KG",
      "email": "integrations@cleverreach.com"
    }
  ],
  "support": {
    "issues": "https://github.com/cleverreach/cleverreachsdk-php/issues",
    "source": "https://github.com/cleverreach/cleverreachsdk-php"
  },
  "require": {
    "php": "^8.2",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "php-http/discovery": "^1.19.2",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10 || ^4.0",
    "phpunit/phpunit": "^11.5",
    "php-http/mock-client": "^1.6",
    "php-http/client-common": "^2.7.1",
    "nyholm/psr7": "^1.8",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CleverReach\\SDK\\": "src/"
    }
  },
  "scripts": {
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs-check": "phpcs --standard=phpcs.xml",
    "cs-fix": "phpcbf --standard=phpcs.xml",
    "test": "phpunit",
    "phpstan": "vendor/bin/phpstan analyse"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
